<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      Required for DriverStationLauncher (com.next2026.robotreset.launch) to see
      the FTC Driver Station app at all. Android 11+ (API 30+) package-visibility
      filtering hides other installed apps from PackageManager queries, including
      getLaunchIntentForPackage(), for any app targeting API 30+, unless the
      target package is declared here. Without this, LAUNCH_DS fails safe with
      "package not found" even though the app is genuinely installed: confirmed by
      real-hardware testing on Fable's phone (targetSdk 34), where
      getLaunchIntentForPackage(DriverStationLauncher.DS_PACKAGE) returned null
      until this element was added. adb shell monkey/pm commands are exempt from
      this filtering (shell UID), which is why a pre-implementation bench check
      using those tools did not catch this; an ordinary installed app is not
      exempt.
    -->
    <queries>
        <package android:name="com.qualcomm.ftcdriverstation" />
    </queries>

    <application
        android:allowBackup="true"
        android:icon="@android:drawable/sym_def_app_icon"
        android:label="@string/app_name"
        android:theme="@android:style/Theme.DeviceDefault.Light">

        <activity
            android:name=".ui.KeyMonitorActivity"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.StatusActivity"
            android:exported="false"
            android:label="Status" />

        <activity
            android:name=".config.ConfigActivity"
            android:exported="false"
            android:label="Config" />

        <activity
            android:name=".launch.DsLaunchActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />

        <service
            android:name=".RobotResetService"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE"
            android:exported="true">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

    </application>

</manifest>
