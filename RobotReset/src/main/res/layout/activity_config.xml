<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textStyle="bold"
            android:textSize="16sp"
            android:paddingBottom="4dp"
            android:text="OpMode slot names" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="8dp"
            android:text="Ctrl+Alt+F5..F8 select slots 0..3. Names here are what gets matched by visible text in the OpMode list." />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:id="@+id/opmode_slot_container" />

        <Button
            android:id="@+id/save_slots_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="20dp"
            android:text="Save slot names" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#CCCCCC"
            android:layout_marginBottom="16dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textStyle="bold"
            android:textSize="16sp"
            android:paddingBottom="4dp"
            android:text="Target overrides" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="8dp"
            android:text="Every default in this app is a guess pending the real-hardware check. If the phone's DS app doesn't match, fix it here instead of rebuilding." />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Target:" />

        <Spinner
            android:id="@+id/override_key_spinner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="8dp" />

        <TextView
            android:id="@+id/current_spec_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="8dp"
            android:text="Current effective spec: (unknown)" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="New override kind:" />

        <RadioGroup
            android:id="@+id/override_kind_group"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingBottom="8dp">

            <RadioButton
                android:id="@+id/kind_text_radio"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="TEXT" />

            <RadioButton
                android:id="@+id/kind_view_id_radio"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:text="VIEW_ID" />

        </RadioGroup>

        <EditText
            android:id="@+id/override_value_edit"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Override value (e.g. INIT, or a resource-id)"
            android:paddingBottom="8dp" />

        <Button
            android:id="@+id/save_override_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            android:text="Save override" />

        <Button
            android:id="@+id/back_to_status_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Back to Status" />

    </LinearLayout>

</ScrollView>
